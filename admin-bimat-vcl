          <button class="primary" onclick="openEditUserModal('${u.phone}')">✏️ Sửa toàn bộ thông tin</button>
          <button class="${u.locked ? 'secondary' : 'danger'}" onclick="Store.update('users/${u.phone}', {locked: ${!u.locked}})">${u.locked ? 'Mở khóa TK' : 'Khóa TK'}</button>
