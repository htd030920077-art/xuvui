let allUsersCache = {}, allTasksCache = {}, serverConfig = { isClosed: false, message: 'Hệ thống đang bảo trì nâng cấp tính năng. Vui lòng quay lại sau ít phút!', whitelistPhones: '' };

function initAdmin() {
  $('conn-status').textContent = useFirebase ? '🟢 Firebase Cloud (xuvui-9175f)' : '🟡 Local Sync';

  Store.onValue('system/server', val => {
    if (val) serverConfig = { ...serverConfig, ...val };
    const banner = $('server-banner');
    const btn = $('btn-toggle-server');
    if (serverConfig.isClosed) {
      banner.className = 'server-banner offline';
      $('srv-title').textContent = '🔴 SERVER ĐANG ĐÓNG (CHẾ ĐỘ BẢO TRÌ)';
      $('srv-desc').textContent = `Thông báo hiển thị cho khách: "${serverConfig.message}"`;
      btn.className = 'primary';
      btn.textContent = '🟢 Mở lại Server ngay';
    } else {
      banner.className = 'server-banner online';
      $('srv-title').textContent = '🟢 SERVER ĐANG MỞ HOẠT ĐỘNG BÌNH THƯỜNG';
      $('srv-desc').textContent = 'Tất cả thành viên đang truy cập và làm nhiệm vụ bình thường.';
      btn.className = 'danger';
      btn.textContent = '🛑 Đóng Server (Bảo trì)';
    }
  });

  Store.onValue('users', val => {
    allUsersCache = val || {};
    $('st-users').textContent = Object.keys(allUsersCache).length;
    renderUsers();
  });

  Store.onValue('deposits', val => {
    const items = Object.entries(val || {}).map(([k, v]) => ({ key: k, ...v })).sort((a, b) => b.createdAt - a.createdAt);
    const pendingCount = items.filter(i => i.status === 'pending').length;
    $('st-deposits').textContent = pendingCount;
    $('cnt-dep').textContent = pendingCount;

    $('admin-deposit-list').innerHTML = items.length ? items.map(d => `
      <div class="card">
        <div class="row">
          <div>
            <strong style="font-size:15px;color:var(--green)">Nạp ${money(d.amount)}</strong> — <b>${esc(d.userName)}</b> (${esc(d.phone)})<br>
            <small>Nội dung CK: <code>${esc(d.memo)}</code> · ${new Date(d.createdAt).toLocaleString('vi-VN')}</small>
          </div>
          <span class="badge ${d.status}">${d.status === 'verified' ? 'Đã duyệt' : d.status === 'rejected' ? 'Từ chối' : 'Chờ duyệt'}</span>
        </div>
        ${d.receipt ? `<div style="margin:10px 0"><a href="${d.receipt}" target="_blank"><img src="${d.receipt}" style="width:100px;height:100px;object-fit:cover;border-radius:10px;border:1px solid #ccc"></a></div>` : ''}
        ${d.status === 'pending' ? `<div style="display:flex;gap:8px;margin-top:10px">
          <button class="primary" onclick="approveDeposit('${d.key}', '${d.phone}', ${d.amount})">✅ Duyệt nạp +${money(d.amount)} (Mở VIP)</button>
          <button class="danger" onclick="rejectDeposit('${d.key}', '${d.phone}', ${d.amount})">❌ Từ chối</button>
        </div>` : ''}
