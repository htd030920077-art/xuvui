    const plots = u.plots ? Object.entries(u.plots) : [];
    const plotText = plots.length
      ? plots.map(([k, p]) => `${k.toUpperCase()}: ${CROP_NAMES[p.crop] || p.crop} (${Date.now() >= p.readyAt ? 'Đã chín' : 'Đang lớn'})`).join(' | ')
