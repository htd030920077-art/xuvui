    if ($('eu-plot-' + i).checked) purchasedPlots['p' + i] = true;
  });

  await Store.update('users/' + phone, {
    name: $('eu-name').value.trim(),
    inviteCode: $('eu-code').value.trim().toUpperCase(),
    password: $('eu-pass').value.trim(),
    pin: $('eu-pin').value.trim(),
    balance: newBalance,
    totalDeposited: Number($('eu-deposited').value) || 0,
    withdrawn: Number($('eu-withdrawn').value) || 0,
    farmLevel: Math.max(1, Number($('eu-lv').value) || 1),
    farmExp: Math.max(0, Number($('eu-exp').value) || 0),
    farmEarned: Math.max(0, Number($('eu-farm-earned').value) || 0),
    purchasedPlots,
    locked: $('eu-locked').value === 'true'
  });

  await Store.push('history/' + phone, {
    title: 'Quản trị viên cập nhật tài khoản',
    amount: `Số dư: ${money(newBalance)}`,
    icon: '⚙️',
    detail: 'Cập nhật thông tin từ hệ thống Admin',
    createdAt: Date.now()
  });

  $('modal-back').classList.remove('open');
};

window.deleteUserAccount = async (phone) => {
  await Store.set('users/' + phone, null);
  $('modal-back').classList.remove('open');
};

window.approveDeposit = async (key, phone, amount) => {
  await Store.update('deposits/' + key, { status: 'verified' });
  const u = await Store.get('users/' + phone);
  if (u) {
    await Store.update('users/' + phone, {
      balance: (u.balance || 0) + Number(amount),
      totalDeposited: (u.totalDeposited || 0) + Number(amount)
    });
    await Store.push('history/' + phone, {
      title: 'Nạp tiền thành công (VietQR)', amount: `+${money(amount)}`, icon: '💳',
      detail: 'Đã cộng số dư & mở khóa gói VIP nông trại', createdAt: Date.now()
    });
  }
};

window.rejectDeposit = async (key, phone, amount) => {
  await Store.update('deposits/' + key, { status: 'rejected' });
  await Store.push('history/' + phone, { title: 'Lệnh nạp tiền bị từ chối', amount: `${money(amount)}`, icon: '❌', detail: 'Chưa nhận được chuyển khoản', createdAt: Date.now() });
};

window.approveProof = async (key, phone, defaultReward, title) => {
  const customAmt = prompt(`Nhập số tiền VNĐ cộng cho nhiệm vụ "${title}":`, defaultReward > 100 ? defaultReward : 500000);
  if (customAmt === null) return;
  const reward = Number(customAmt) || 0;

  await Store.update('submissions/' + key, { status: 'verified' });
  const u = await Store.get('users/' + phone);
  if (u) {
    await Store.update('users/' + phone, { balance: (u.balance || 0) + reward });
    await Store.push('history/' + phone, { title: `Duyệt nhiệm vụ: ${title}`, amount: `+${money(reward)}`, icon: '☑', detail: 'Hoàn thành nhiệm vụ được duyệt', createdAt: Date.now() });

    if (u.referredBy && !u.f1Rewarded) {
      await Store.update('users/' + phone, { f1Rewarded: true });
      const inviter = Object.values(allUsersCache).find(x => x.inviteCode === u.referredBy);
      if (inviter) {
        await Store.update('users/' + inviter.phone, { balance: (inviter.balance || 0) + 200 });
        await Store.update(`users/${inviter.phone}/invited/${phone}`, { qualified: true });
        await Store.push('history/' + inviter.phone, { title: `Hoa hồng F1 (${u.name})`, amount: '+200đ', icon: '♧', detail: 'F1 hoàn thành nhiệm vụ đầu tiên', createdAt: Date.now() });
      }
    }
  }
};

window.rejectProof = async (key) => {
  const reason = prompt('Nhập lý do từ chối:');
  if (reason === null) return;
  await Store.update('submissions/' + key, { status: 'rejected', reviewNote: reason || 'Bằng chứng chưa hợp lệ' });
};

window.showVietQR = (bankId, acc, amount, name, phone) => {
  const url = `https://img.vietqr.io/image/${bankId}-${acc}-compact2.png?amount=${amount}&addInfo=${encodeURIComponent('XUVUI ' + phone)}&accountName=${encodeURIComponent(name)}`;
  $('modal').innerHTML = `<div style="text-align:center"><h3>Quét mã VietQR thanh toán</h3><img src="${url}" style="max-width:260px;border-radius:12px;border:1px solid #ddd"><p><b>${esc(name)}</b> · ${esc(acc)} · <b>${money(amount)}</b></p><button class="primary" onclick="$('modal-back').classList.remove('open')">Đóng</button></div>`;
  $('modal-back').classList.add('open');
};

window.approveWithdraw = async (key, phone, amount) => {
  await Store.update('withdrawals/' + key, { status: 'paid' });
  const u = await Store.get('users/' + phone);
  if (u) await Store.update('users/' + phone, { withdrawn: (u.withdrawn || 0) + Number(amount) });
};

window.rejectWithdraw = async (key, phone, amount) => {
  const reason = prompt('Lý do từ chối (Tiền sẽ hoàn lại ví user):');
  if (reason === null) return;
  await Store.update('withdrawals/' + key, { status: 'rejected', note: reason });
  const u = await Store.get('users/' + phone);
  if (u) {
    await Store.update('users/' + phone, { balance: (u.balance || 0) + Number(amount) });
    await Store.push('history/' + phone, { title: 'Hoàn tiền lệnh rút bị từ chối', amount: `+${money(amount)}`, icon: '↺', detail: reason, createdAt: Date.now() });
  }
};

$('new-gc-form').onsubmit = async e => {
  e.preventDefault();
  const code = $('gc-code').value.trim().toUpperCase();
  await Store.set('giftcodes/' + code, { amount: Number($('gc-amount').value), maxUses: Number($('gc-uses').value), usedCount: 0, active: true });
  $('new-gc-form').reset();
};

$('modal-back').onclick = e => { if (e.target.id === 'modal-back') $('modal-back').classList.remove('open'); };
</script>
</body>
</html>
