<style>
@import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap');
:root{--bg:#f4f7ee;--ink:#243d30;--green:#244d37;--line:#dfe6d7;--lime:#d5f19a;--muted:#7b8c6c;--red:#c94a38;--gold:#d49b27}
*{box-sizing:border-box;max-width:100%}
html,body{margin:0;padding:0;width:100%;overflow-x:hidden;background:var(--bg);color:var(--ink);font:13px 'Be Vietnam Pro',system-ui,sans-serif}
button,input,select,textarea{font:inherit}
button{cursor:pointer;border:0;border-radius:10px;padding:10px 14px;font-weight:700;font-size:11px;transition:transform .15s,opacity .15s}
button:active{transform:translateY(1px)}
[hidden]{display:none!important}
.primary{background:var(--green);color:#fff}
.danger{background:var(--red);color:#fff}
.gold{background:var(--gold);color:#fff}
.secondary{background:#fff;border:1px solid var(--line);color:var(--green)}
header{background:var(--green);color:#fff;padding:14px 20px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;position:sticky;top:0;z-index:20}
.container{max-width:1240px;margin:20px auto;padding:0 14px 60px}
.stats{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:20px}
.stat-box{background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px}
.stat-box span{font-size:10px;color:var(--muted);font-weight:600}
.stat-box strong{display:block;font-size:20px;margin-top:6px;color:var(--green)}
.tabs{display:flex;gap:8px;overflow-x:auto;margin-bottom:18px;padding-bottom:4px}
.tabs button{background:#fff;border:1px solid var(--line);color:#5c704c;white-space:nowrap;padding:11px 15px}
.tabs button.active{background:var(--green);color:#fff}
.tabs button em{font-style:normal;background:#d9534f;color:#fff;padding:2px 6px;border-radius:10px;font-size:9px;margin-left:5px}
.panel{background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px;margin-bottom:18px}
.card{border:1px solid var(--line);border-radius:14px;padding:16px;margin-bottom:12px;background:#fcfdf9}
.row{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap}
label{display:block;font-size:11px;font-weight:700;color:#4f663c;margin:6px 0 4px}
input,select,textarea{width:100%;border:1px solid #d5dec9;border-radius:10px;padding:10px 12px;margin:0 0 12px;background:#fff}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.badge{padding:4px 9px;border-radius:6px;font-size:10px;font-weight:700;display:inline-block}
.badge.pending{background:#fff1cc;color:#997014}
.badge.verified,.badge.paid,.badge.open{background:#e2f3ce;color:#417519}
.badge.rejected,.badge.closed{background:#fbe2de;color:#b53b2a}
.badge.vip{background:#fce8b2;color:#8f620c}
.info-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:8px;background:#f4f8ec;padding:10px 12px;border-radius:10px;margin:10px 0;font-size:11px}
.server-banner{border-radius:16px;padding:18px;margin-bottom:18px;display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;border:2px solid}
.server-banner.online{background:#ebf7e3;border-color:#9fd17b;color:#275914}
.server-banner.offline{background:#fdecea;border-color:#eb9b91;color:#9c2b1e}
.plot-check-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;background:#f4f8ec;padding:12px;border-radius:12px;margin-bottom:14px}
.plot-check-item{display:flex;align-items:center;gap:6px;font-size:11px;font-weight:600;background:#fff;padding:8px;border-radius:8px;border:1px solid var(--line)}
.plot-check-item input{width:16px;height:16px;margin:0}
.login-overlay{position:fixed;inset:0;background:var(--bg);display:grid;place-items:center;z-index:50;padding:16px}
.login-box{background:#fff;padding:28px;border-radius:20px;border:1px solid var(--line);width:360px;max-width:100%}
.modal-back{position:fixed;inset:0;background:#1d342e80;backdrop-filter:blur(4px);z-index:60;display:none;align-items:center;justify-content:center;padding:14px}
.modal-back.open{display:flex}
.modal{background:#fff;border-radius:20px;padding:22px;width:580px;max-width:100%;max-height:92vh;overflow-y:auto}
@media(max-width:850px){.stats{grid-template-columns:1fr 1fr}.grid-2,.grid-3{grid-template-columns:1fr}}
</style>
</head>
