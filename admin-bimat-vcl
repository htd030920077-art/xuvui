<script>
const $ = id => document.getElementById(id);
const esc = v => String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const money = n => new Intl.NumberFormat('vi-VN').format(Number(n) || 0) + 'đ';

// CẤU HÌNH FIREBASE DỰ ÁN XUVUI-9175F
const FIREBASE_CONFIG = {
  apiKey: "AIzaSyCbtZV-aW22WtYxeN6vW8qmdmEWeMaG97o",
  authDomain: "xuvui-9175f.firebaseapp.com",
  databaseURL: "https://xuvui-9175f-default-rtdb.asia-southeast1.firebasedatabase.app",
  projectId: "xuvui-9175f",
  storageBucket: "xuvui-9175f.firebasestorage.app",
  messagingSenderId: "655275789249",
  appId: "1:655275789249:web:5b355911895f6782a47d40",
  measurementId: "G-ZEH3GKR3CY"
};

const ADMIN_PASSWORDS = ["admin123", "123456"];

const BANK_CODES = {"Vietcombank":"VCB","MBBank":"MB","Techcombank":"TCB","BIDV":"BIDV","VietinBank":"ICB","Agribank":"VBA","ACB":"ACB","VPBank":"VPB","TPBank":"TPB","Sacombank":"STB","HDBank":"HDB","VIB":"VIB","SHB":"SHB","MSB":"MSB","OCB":"OCB","CAKE":"CAKE","Timo":"TIMO","SeABank":"SEAB","LPBank":"LPB"};
const CROP_NAMES = {rice:'Lúa nước',corn:'Ngô ngọt',wheat:'Lúa mì vàng',bronze:'Cây Đồng',silver:'Cây Bạc',gold:'Cây Vàng',diamond:'Kim cương',platinum:'Platinum',super_platinum:'Super Platinum'};

let useFirebase = false, db = null;
try {
  firebase.initializeApp(FIREBASE_CONFIG);
  db = firebase.database();
  useFirebase = true;
} catch (e) {}

const Store = {
  _localGet(path) {
    try {
      const root = JSON.parse(localStorage.getItem('xuvui_db') || '{}');
      return path.split('/').filter(Boolean).reduce((o, k) => (o && o[k] !== undefined ? o[k] : null), root);
    } catch { return null; }
  },
  _localSet(path, val) {
    try {
      const root = JSON.parse(localStorage.getItem('xuvui_db') || '{}');
      const keys = path.split('/').filter(Boolean);
      let cur = root;
      for (let i = 0; i < keys.length - 1; i++) {
        if (!cur[keys[i]] || typeof cur[keys[i]] !== 'object') cur[keys[i]] = {};
        cur = cur[keys[i]];
      }
      if (val === null) delete cur[keys[keys.length - 1]];
      else cur[keys[keys.length - 1]] = val;
      localStorage.setItem('xuvui_db', JSON.stringify(root));
      window.dispatchEvent(new Event('xuvui_local_sync'));
    } catch {}
  },
  async get(path) {
    if (useFirebase) { try { const s = await db.ref(path).once('value'); return s.val(); } catch { useFirebase = false; } }
    return this._localGet(path);
  },
  async set(path, val) {
    if (useFirebase) { try { await db.ref(path).set(val); return; } catch { useFirebase = false; } }
    this._localSet(path, val);
  },
  async update(path, obj) {
    if (useFirebase) { try { await db.ref(path).update(obj); return; } catch { useFirebase = false; } }
    const cur = this._localGet(path) || {};
    Object.entries(obj).forEach(([k, v]) => {
      if (k.includes('/')) this._localSet(path + '/' + k, v);
      else cur[k] = v;
    });
    if (!Object.keys(obj).some(k => k.includes('/'))) this._localSet(path, cur);
  },
  async push(path, val) {
    const id = 'id_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6);
    await this.set(path + '/' + id, val);
    return id;
  },
  onValue(path, cb) {
    if (useFirebase) db.ref(path).on('value', s => cb(s.val()));
    else { cb(this._localGet(path)); window.addEventListener('xuvui_local_sync', () => cb(this._localGet(path))); }
  }
};

function compressImgAdmin(file, maxW = 450) {
  return new Promise(resolve => {
    const r = new FileReader();
    r.onload = e => {
      const img = new Image();
      img.onload = () => {
        const c = document.createElement('canvas');
        const s = img.width > maxW ? maxW / img.width : 1;
        c.width = img.width * s; c.height = img.height * s;
        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
        resolve(c.toDataURL('image/jpeg', 0.72));
      };
      img.src = e.target.result;
    };
    r.readAsDataURL(file);
  });
}

